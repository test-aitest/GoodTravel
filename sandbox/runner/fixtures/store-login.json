 "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>Sign in - Store Admin</title>\n<style>\nbody{margin:0;font-family:system-ui,-apple-system,\"Segoe UI\",Arial,sans-serif;font-size:13px;color:#1f2328;background:#fbfbfa}\n.shell{display:grid;grid-template-columns:180px minmax(0,1fr);min-height:100vh}\n.sidebar{background:#2b2b2b;color:#e8e8e8;padding:16px 12px;display:flex;flex-direction:column;gap:10px}\n.store-name{color:#fff;font-weight:700;font-size:15px}\n.nav{display:flex;flex-direction:column;gap:8px}\n.nav-current{color:#fff;font-weight:700}\n.signout{margin-top:auto;font:inherit;color:#e8e8e8;background:transparent;border:1px solid #666;border-radius:4px;padding:4px 8px;cursor:pointer}\n.main{padding:20px 24px;display:flex;flex-direction:column;gap:12px;max-width:820px}\n.page-title{margin:0;font-size:18px}\n.inventory-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e3e3e3}\n.inventory-table th{background:#f6f6f6;text-align:left;padding:6px 8px;font-weight:600}\n.inventory-table td{padding:5px 8px;border-top:1px solid #eee}\n.qty{width:72px;font:inherit;padding:3px 5px;text-align:right;border:1px solid #c9c9c9;border-radius:3px}\n.save-bar{display:flex;gap:10px;align-items:center;padding:10px 0}\n.btn-save{font:inherit;font-weight:600;padding:6px 16px;border-radius:4px;border:1px solid #2f6fb0;background:#2f6fb0;color:#fff;cursor:pointer}\n.btn-other{font:inherit;font-weight:600;padding:6px 16px;border-radius:4px;border:1px solid #2f6fb0;background:#fff;color:#2f6fb0;cursor:pointer}\n.discard{color:#57606a}\n.notice{margin:0;padding:8px 10px;border-radius:4px;background:#e7f4ea;border:1px solid #9fd1ab;color:#1e5b2c}\n.error{margin:0;padding:8px 10px;border-radius:4px;background:#fdecea;border:1px solid #e0a39e;color:#8a1c14}\n.login-page{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.login-box{display:flex;flex-direction:column;gap:12px;width:300px;padding:24px;background:#fff;border:1px solid #e3e3e3;border-radius:6px}\n.field{display:flex;flex-direction:column;gap:4px}\n.field input{font:inherit;padding:6px;border:1px solid #c9c9c9;border-radius:3px}\n.hint{margin:0;color:#57606a}\n</style>\n</head>\n<body>\n<main class=\"login-page\">\n<form class=\"login-box\" method=\"post\" action=\"/login\">\n<h1 class=\"page-title\">Store Admin</h1>\n<p class=\"hint\">Sign in to manage your store.</p>\n\n<label class=\"field\">Username<input name=\"username\" autocomplete=\"username\" required></label>\n<label class=\"field\">Password<input name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label>\n<button class=\"btn-save\" type=\"submit\">Sign in</button>\n</form>\n</main>\n\n\n</body></html>"
