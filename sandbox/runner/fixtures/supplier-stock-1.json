 "html": "<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>Stock list - Maruyama Supply</title>\n<style>\nbody{margin:0;font-family:Verdana,Tahoma,Arial,sans-serif;font-size:12px;color:#222;background:#f2f2f2}\n.topbar{display:flex;align-items:center;gap:12px;padding:8px 16px;background:#1f3a68;color:#fff}\n.brand{font-weight:bold;font-size:15px}\n.portal{color:#cfd8e6}\n.account{margin-left:auto;color:#dfe6f0}\n.signout{font:inherit;color:#fff;background:transparent;border:1px solid #8ea2c2;padding:2px 8px;cursor:pointer}\n.content{max-width:900px;margin:16px auto;padding:16px;background:#fff;border:1px solid #c8c8c8}\n.title{margin:0 0 6px;font-size:16px}\n.meta{margin:0 0 12px;color:#666}\n.stock-table{width:100%;border-collapse:collapse}\n.stock-table th{background:#e8edf4;text-align:left;padding:5px 6px;border:1px solid #c8c8c8}\n.stock-table td{padding:4px 6px;border:1px solid #dcdcdc}\n.stock-table tbody tr:nth-child(even){background:#f8f8f8}\n.num{text-align:right}\n.status-in{color:#2c6e2f}\n.status-low{color:#a15c00}\n.status-out{color:#b3261e;font-weight:bold}\n.pager{display:flex;gap:8px;align-items:center;margin-top:10px}\n.pager a{color:#2f6fb0}\n.pager-current{font-weight:bold}\n.login-box{display:flex;flex-direction:column;gap:10px;max-width:320px}\n.field{display:flex;flex-direction:column;gap:3px}\n.field input{font:inherit;padding:4px;border:1px solid #999}\n.button{align-self:flex-start;font:inherit;padding:4px 14px;background:#2f6fb0;color:#fff;border:1px solid #1f3a68;cursor:pointer}\n.error{margin:0;padding:6px 8px;background:#fdecea;border:1px solid #e0a39e;color:#8a1c14}\n.sr-note{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.footer{max-width:900px;margin:0 auto 16px;color:#888;font-size:11px}\n</style>\n</head>\n<body>\n<header class=\"topbar\"><span class=\"brand\">Maruyama Supply</span><span class=\"portal\">Partner Portal</span><span class=\"account\">Signed i